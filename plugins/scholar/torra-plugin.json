{
  "id": "scholar",
  "name": "学者工作台",
  "version": "0.1.0",
  "apiVersion": 1,
  "description": "论文库、精读笔记、多篇对比、Idea 书柜与引用格式化。元数据来自 arXiv / Crossref，其余数据都留在本机。",
  "main": "main.js",
  "ui": "ui.html",
  "permissions": ["storage", "panel", "tools", "ai", "net:export.arxiv.org", "net:api.crossref.org"],
  "contributes": {
    "panel": { "title": "学者工作台", "icon": "book" },
    "tools": [
      {
        "name": "scholar_search_papers",
        "label": "检索论文",
        "description": "按标题、关键词、DOI 或 arXiv 编号在 arXiv 与 Crossref 上检索论文，返回题名、作者、年份、DOI/arXiv 号与链接。用户在问某篇论文或某个方向有哪些工作时先用它。",
        "parameters": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "检索词；可以是关键词、DOI 或 arXiv 编号" },
            "limit": { "type": "integer", "description": "返回条数，1-10，缺省 6" }
          },
          "required": ["query"],
          "additionalProperties": false
        }
      },
      {
        "name": "scholar_add_paper",
        "label": "加入论文库",
        "description": "把一篇论文收进本地论文库。给出 DOI 或 arXiv 编号时会自动抓取元数据；重复的 DOI/arXiv 号/题名不会重复入库。",
        "parameters": {
          "type": "object",
          "properties": {
            "title": { "type": "string", "description": "题名；只给 DOI/arXiv 号时可省略" },
            "doi": { "type": "string", "description": "DOI，例如 10.1145/3292500.3330701" },
            "arxivId": { "type": "string", "description": "arXiv 编号，例如 2401.12345" },
            "authors": { "type": "array", "items": { "type": "string" }, "description": "作者列表；给了 DOI/arXiv 时以抓取结果为准" },
            "year": { "type": "string", "description": "四位年份" },
            "venue": { "type": "string", "description": "期刊或会议" },
            "url": { "type": "string", "description": "论文链接" },
            "abstract": { "type": "string", "description": "摘要" },
            "tags": { "type": "array", "items": { "type": "string" }, "description": "标签" },
            "status": { "type": "string", "enum": ["todo", "reading", "read", "parked"], "description": "阅读状态，缺省 todo" }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "scholar_list_papers",
        "label": "列出论文",
        "description": "列出本地论文库，可按阅读状态、标签、关键词过滤。写综述或对比之前先看这里已经收了什么，避免重复添加。",
        "parameters": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["todo", "reading", "read", "parked"], "description": "只看这个阅读状态" },
            "tag": { "type": "string", "description": "只看带这个标签的论文" },
            "query": { "type": "string", "description": "题名/摘要/标签里的关键词" },
            "limit": { "type": "integer", "description": "最多返回多少条，缺省 200" }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "scholar_get_paper",
        "label": "读论文卡片",
        "description": "读取一篇已收藏论文的完整信息，包括精读笔记（结论/证据/实验/局限）与保存的追问。",
        "parameters": {
          "type": "object",
          "properties": {
            "paperId": { "type": "string", "description": "论文 id（来自 scholar_list_papers）" }
          },
          "required": ["paperId"],
          "additionalProperties": false
        }
      },
      {
        "name": "scholar_update_paper",
        "label": "修改论文",
        "description": "修改论文的阅读状态、星标、标签或元数据。只传要改的字段。",
        "parameters": {
          "type": "object",
          "properties": {
            "paperId": { "type": "string", "description": "论文 id" },
            "title": { "type": "string", "description": "新题名" },
            "authors": { "type": "array", "items": { "type": "string" }, "description": "新作者列表" },
            "year": { "type": "string", "description": "四位年份" },
            "venue": { "type": "string", "description": "期刊或会议" },
            "url": { "type": "string", "description": "链接" },
            "abstract": { "type": "string", "description": "摘要" },
            "tags": { "type": "array", "items": { "type": "string" }, "description": "整组替换的标签" },
            "status": { "type": "string", "enum": ["todo", "reading", "read", "parked"], "description": "阅读状态" },
            "star": { "type": "boolean", "description": "是否星标" },
            "doi": { "type": "string", "description": "DOI" }
          },
          "required": ["paperId"],
          "additionalProperties": false
        }
      },
      {
        "name": "scholar_remove_paper",
        "label": "移除论文",
        "description": "从论文库移除一篇论文（同时从 Idea 的关联里摘掉）。用户明确要删时才用。",
        "parameters": {
          "type": "object",
          "properties": {
            "paperId": { "type": "string", "description": "论文 id" }
          },
          "required": ["paperId"],
          "additionalProperties": false
        }
      },
      {
        "name": "scholar_save_reading",
        "label": "保存精读笔记",
        "description": "给一篇论文写入精读笔记：结论、证据、实验、局限，或追加一条追问。只写有依据的内容，不要把摘要改写成结论。",
        "parameters": {
          "type": "object",
          "properties": {
            "paperId": { "type": "string", "description": "论文 id" },
            "conclusion": { "type": "string", "description": "核心结论" },
            "evidence": { "type": "string", "description": "支撑结论的证据" },
            "experiments": { "type": "string", "description": "实验设置与关键数字" },
            "limitations": { "type": "string", "description": "作者承认或你发现的局限" },
            "question": { "type": "string", "description": "追加一条读完后的追问" },
            "status": { "type": "string", "enum": ["todo", "reading", "read", "parked"], "description": "顺带改阅读状态" }
          },
          "required": ["paperId"],
          "additionalProperties": false
        }
      },
      {
        "name": "scholar_compare",
        "label": "多篇对比",
        "description": "把二到六篇已收藏的论文放在一起对比：方法、证据、实验、局限各自并排。适合回答「这几篇差在哪」。",
        "parameters": {
          "type": "object",
          "properties": {
            "paperIds": { "type": "array", "items": { "type": "string" }, "description": "要对比的论文 id，2-6 个" }
          },
          "required": ["paperIds"],
          "additionalProperties": false
        }
      },
      {
        "name": "scholar_cite",
        "label": "生成引用",
        "description": "为论文生成 GB/T 7714、APA 7 或 BibTeX 引用。只引用论文库里真实存在的条目，不要手写作者与年份。",
        "parameters": {
          "type": "object",
          "properties": {
            "paperIds": { "type": "array", "items": { "type": "string" }, "description": "要引用的论文 id" },
            "style": { "type": "string", "enum": ["gbt", "apa", "bibtex"], "description": "引用格式，缺省 gbt" }
          },
          "required": ["paperIds"],
          "additionalProperties": false
        }
      },
      {
        "name": "scholar_add_idea",
        "label": "记一条 Idea",
        "description": "把研究想法记进 Idea 书柜：来源、创新点、支撑证据、验证状态，可关联已收藏的论文。",
        "parameters": {
          "type": "object",
          "properties": {
            "title": { "type": "string", "description": "一句话想法" },
            "source": { "type": "string", "description": "从哪来的（论文、讨论、失败实验）" },
            "innovation": { "type": "string", "description": "相比现有做法新在哪" },
            "evidence": { "type": "string", "description": "已有证据或反例" },
            "status": { "type": "string", "enum": ["draft", "testing", "confirmed", "rejected"], "description": "验证状态，缺省 draft" },
            "paperIds": { "type": "array", "items": { "type": "string" }, "description": "关联论文 id" }
          },
          "required": ["title"],
          "additionalProperties": false
        }
      },
      {
        "name": "scholar_update_idea",
        "label": "修改 Idea",
        "description": "更新想法内容、验证状态或关联论文。整组替换 paperIds。",
        "parameters": {
          "type": "object",
          "properties": {
            "ideaId": { "type": "string", "description": "Idea id" },
            "title": { "type": "string", "description": "新标题" },
            "source": { "type": "string", "description": "来源" },
            "innovation": { "type": "string", "description": "创新点" },
            "evidence": { "type": "string", "description": "证据" },
            "status": { "type": "string", "enum": ["draft", "testing", "confirmed", "rejected"], "description": "验证状态" },
            "paperIds": { "type": "array", "items": { "type": "string" }, "description": "关联论文 id（整组替换）" }
          },
          "required": ["ideaId"],
          "additionalProperties": false
        }
      },
      {
        "name": "scholar_list_ideas",
        "label": "列出 Idea",
        "description": "列出 Idea 书柜，可按验证状态过滤。做方案取舍时先看这里已经记过什么。",
        "parameters": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["draft", "testing", "confirmed", "rejected"], "description": "只看这个状态" }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "scholar_export_ideas",
        "label": "导出 Idea 书柜",
        "description": "把 Idea 书柜导出成 Markdown 清单（含状态、来源、证据与关联论文），用于写报告或存档。",
        "parameters": {
          "type": "object",
          "properties": {
            "format": { "type": "string", "enum": ["markdown"], "description": "目前只支持 markdown" }
          },
          "additionalProperties": false
        }
      }
    ],
    "prompts": [
      {
        "id": "workflow",
        "title": "工作方式",
        "text": "你在和一个使用「学者工作台」的研究者协作。论文库、精读笔记、Idea 与引用都在这个插件里，工具名以 scholar_ 开头。\n\n用法：\n1. 找文献：先用 scholar_search_papers；用户给了 DOI / arXiv 编号就直接用它检索。找到后把候选列出来，不要一次加十几篇。\n2. 入库：用户确认后才 scholar_add_paper。已经有 DOI/arXiv 号时交给工具抓元数据，不要自己填作者和年份。\n3. 精读：读到的结论、证据、实验、局限写进 scholar_save_reading，四类分开；摘要原文不是结论。没有依据的推断标成「推断」。\n4. 对比：二到六篇用 scholar_compare，按字段并排讲差异与适用条件。\n5. 引用：一律用 scholar_cite 生成 GB/T 7714 / APA / BibTeX，不要凭记忆写引用条目。\n6. Idea：来源、创新点、证据、验证状态分开记；被否掉的也留着，标 rejected。\n\n红线：论文库里没有的文献，不要假装它在库里；找不到就直说没检索到，并给出检索词。"
      }
    ]
  }
}

# Dependencies
node_modules/

# Build output (tsc -> dist/main|preload|shared, vite -> dist/renderer)
dist/
# 打包产物（electron-builder -> release/）：安装包里是完整的 Electron + 本机路径
release/
*.tsbuildinfo
.vite/

# 研讨屏「观点演化视图」的离线预览产物（preview-lab-flow.mjs 产出，每次重新生成）
scripts/.lab-flow/

# Runtime artifacts: session runs, reports, probes, backups
output/

# Screenshot / capture artifacts
screenshot.png
*.capture.png

# 站点扫描 / 运行时验证的机器生成证据：里面是站点真实 DOM 快照，
# 会带第三方 CDN 的签名 URL（q-ak / q-signature）和本机绝对路径，不入库。
docs/domscan-*.json
docs/domcheck-*.json
docs/verify-*.json

# 验证/诊断脚本每跑一次就整体重写的产物（截图、断言报告、doctor 体检落盘）。
# 只有 README 顶部两张当封面用的除外 —— 它们跟着改会变成无谓的图片 diff。
docs/smoke-*
!docs/smoke-dock-split.png
!docs/smoke-discussion-flow.png
docs/verify-*
docs/diagnose-*
docs/diagnose/
docs/snapshot-*.json
.ts-node-out/

# Stray compiled files under source (app is TypeScript; builds go to dist/)
src/**/*.js
src/**/*.js.map

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Secrets / local environment — never commit
.env
.env.*
*.key
credentials*.json

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini

# Local agent/tooling workspace (not part of the app)
.workbuddy/
.omc/
.spec-workflow/
.serena/
# .cxh/ 是本地分析工作区（外部项目的源码副本与笔记），不入版本管理。
# 它跟上面那几个一样是本机的工作台，不是应用的一部分。
.cxh/
# 研究工作台的抓取缓存（网页原文、截图、HTML）：随时可以重抓，不入库。
research/**/.tmp/

# UI 方向小样与评审记录（oil-ui 产物）：每轮重新生成，不入库
.design/

# 本机调研脚手架：Playwright 截图、科研工作台的离线预览服务、
# 从 nnscholar.com 抽出来的设计语言文件。都是本机验证用的中间产物。
.playwright-mcp/
.swiss-harness/
design-extract-output/
# 科研工作台面板的离线预览（preview-research-panel.cjs 产出，每次重新生成）
.panel-preview/

# Autopilot engine working dir：state / metrics / screenshots 与治理 markdown 全部留在本机，
# 不进版本管理。
.autopilot/

# 本机截图小工具：窗口标题与落盘路径都写死在本机，不入库
take-screenshot.ps1

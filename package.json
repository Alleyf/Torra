{
  "name": "torra",
  "version": "0.1.0",
  "description": "Torra — 多模型 AI 议事厅桌面客户端",
  "productName": "Torra",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "icons": "electron scripts/make-icons.js",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir",
    "verify:package": "node scripts/verify-package.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test:invariants": "ts-node -P tsconfig.test.json scripts/test-invariants.ts",
    "test:hallucination": "ts-node -P tsconfig.test.json scripts/test-hallucination.ts",
    "test:dedup": "ts-node -P tsconfig.test.json scripts/test-dedup.ts",
    "test:argmap": "ts-node -P tsconfig.test.json scripts/test-argmap.ts",
    "test:render-guard": "ts-node -P tsconfig.test.json scripts/test-render-guard.ts",
    "test:orchestrator-e2e": "ts-node -P tsconfig.test.json scripts/test-orchestrator-e2e.ts",
    "test:anonymity": "ts-node -P tsconfig.test.json scripts/test-anonymity.ts",
    "test:adapters": "ts-node -P tsconfig.test.json scripts/test-adapters.ts",
    "test:session": "ts-node -P tsconfig.test.json scripts/test-session.ts",
    "test:api-retry": "ts-node -P tsconfig.test.json scripts/test-api-retry.ts",
    "test:credential-expiry": "ts-node -P tsconfig.test.json scripts/test-credential-expiry.ts",
    "test:smart-add": "ts-node -P tsconfig.test.json scripts/test-smart-add.ts",
    "test:assistant": "ts-node -P tsconfig.test.json scripts/test-assistant-provider.ts",
    "test:assistant-tools": "ts-node -P tsconfig.test.json scripts/test-assistant-tools.ts",
    "test:assistant-e2e": "ts-node -P tsconfig.test.json scripts/test-assistant-e2e.ts",
    "test:assistant-bridge": "ts-node -P tsconfig.test.json scripts/test-assistant-bridge.ts",
    "test:assistant-stats": "ts-node -P tsconfig.test.json scripts/test-assistant-stats.ts",
    "test:assistant-skills": "ts-node -P tsconfig.test.json scripts/test-assistant-skills.ts",
    "test:assistant-plugins": "ts-node -P tsconfig.test.json scripts/test-assistant-plugins.ts",
    "test:assistant-plugin-host": "ts-node -P tsconfig.test.json scripts/test-assistant-plugin-host.ts",
    "test:assistant-authoring": "ts-node -P tsconfig.test.json scripts/test-assistant-authoring.ts",
    "test": "npm run test:invariants && npm run test:hallucination && npm run test:dedup && npm run test:argmap && npm run test:render-guard && npm run test:orchestrator-e2e && npm run test:anonymity && npm run test:adapters && npm run test:session && npm run test:api-retry && npm run test:credential-expiry && npm run test:smart-add && npm run test:assistant && npm run test:assistant-tools && npm run test:assistant-bridge && npm run test:assistant-stats && npm run test:assistant-skills && npm run test:assistant-plugins && npm run test:assistant-plugin-host && npm run test:assistant-authoring && npm run test:assistant-e2e",
    "diagnose:webview": "electron scripts/diagnose-webview.js",
    "diagnose:partitions": "electron scripts/diagnose-partitions.js",
    "verify:inject": "electron scripts/verify-inject.js",
    "verify:status-light": "electron scripts/verify-status-light.js",
    "verify:self-authoring": "node scripts/verify-self-authoring.mjs",
    "verify:credential-expiry": "node scripts/verify-credential-expiry.mjs",
    "verify:slash-overlay": "node scripts/verify-slash-overlay.mjs",
    "scan:selectors": "electron scripts/scan-selectors.js",
    "snapshot:partition": "electron scripts/snapshot-partition.js",
    "smoke": "electron scripts/smoke.js",
    "verify:flush": "electron scripts/verify-flush.js",
    "domcheck": "electron scripts/domcheck.js",
    "list:cookies": "electron scripts/list-cookies.js",
    "verify:pool-budget": "electron scripts/verify-pool-budget.js",
    "verify:warm-on-demand": "electron scripts/verify-warm-on-demand.js",
    "doctor": "electron scripts/doctor.js",
    "verify:splitter": "node scripts/verify-splitter.mjs"
  },
  "author": "Torra",
  "license": "MIT",
  "devDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@rollup/rollup-win32-x64-msvc": "^4.64.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "lucide-react": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "1.3.7",
    "yaml": "^2.6.1",
    "zustand": "^5.0.2"
  }
}
